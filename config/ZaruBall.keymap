//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   2

// https://note.com/kloir_z/n/n314e739f03a1よりコピペ
// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          INT_YEN           // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(INT_YEN)       // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   UNDERSCORE        // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

// コピペここまで
// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_temp_layer MOUSE 500
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo RAISE>, <&mo MOUSE>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo RAISE>, <&mo MOUSE>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };

        td_LCTL_LCTL_LY2_LY5: tap_dance_LCTL_LCTL_LY2_LY5 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LCTRL LCTRL>, <&mo RAISE>, <&mo 5>;

            label = "TAP_DANCE_LCTL_LCTL_LY2_LY45";
        };

        td_RCTL_RCTL_LY2_LY4: tap_dance_RCTL_.RCTL_LY2_LY4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTRL RCTRL>, <&mo RAISE>, <&mo MOUSE>;

            label = "TAP_DANCE_RCTL_RCTL_LY2_LY4";
        };

        mo_for_jp__JP_AT_JP_BACKQUOTE: mod-morph-for-jp--jp-at-jp-backquote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET>, <&kp LEFT_BRACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "MOD-MORPH_for_jp__JP_AT-JP_BACKQUOTE";
        };

        mo_for_jp__JP_YEN_JP_PIPE: mod-morph-for-jp--jp-yen-jp-pipe {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp INT_YEN>, <&kp LS(INT_YEN)>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "MOD-MORPH_for_jp__JP_YEN-JP_PIPE";
        };

        mo_for_jp__JP_LBRACKET_JP_LBRACE: mod-morph-for-jp--jp-lbracket-jp-lbrace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET>, <&kp RIGHT_BRACE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "MOD-MORPH_for_jp__JP_LBRACKET-JP_LBRACE";
        };

        mo_for_jp__JP_RBRACKET_JP_RBRACE: mod-morph-for-jp--jp-rbracket-jp-rbrace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BACKSLASH>, <&kp PIPE>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "MOD-MORPH_for_jp__JP_RBRACKET-JP_RBRACE";
        };

        mo_for_jp__JP_YEN_JP_UNDERSCORE: mo-for-jp--jp-yen-jp-underscore {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp INT_YEN>, <&kp INT_RO>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <(MOD_LSFT|MOD_RSFT)>;
            label = "MOD-MORPH_for_jp__JP_YEN-JP_UNDERSCORE";
        };

        // ----- ノブ回転 -----
        // 正方向（CW: 上方向）の処理チェーン
        // Ctrl + ノブ回転 → Ctrl+PageUp

        enc_cw_ctrl: encoder-cw-ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            // デフォルト: スクロールアップ
            // Ctrl 押しながら回転: Ctrl + PageUp

            bindings = <&msc SCRL_UP>, <&kp LC(PG_UP)>;

            mods = <(MOD_LCTL | MOD_RCTL)>;
        };

        // Alt + ノブ回転 → Alt+Tab

        enc_cw_alt: encoder-cw-alt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            // 通常: enc_cw_ctrl（スクロール or Ctrl+PgUp）
            // Alt 押しながら: Alt+Tab

            bindings = <&enc_cw_ctrl>, <&kp LA(TAB)>;

            mods = <(MOD_LALT | MOD_RALT)>;
            keep-mods = <(MOD_LALT | MOD_RALT)>;
        };

        // 負方向（CCW: 下方向）の処理チェーン
        // Ctrl + ノブ回転 → Ctrl+PageDown

        enc_ccw_ctrl: encoder-ccw-ctrl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            // デフォルト: スクロールダウン
            // Ctrl 押しながら回転: Ctrl + PageDown

            bindings = <&msc SCRL_DOWN>, <&kp LC(PG_DN)>;

            mods = <(MOD_LCTL | MOD_RCTL)>;
        };

        // Alt + ノブ回転 → Alt+Shift+Tab

        enc_ccw_alt: encoder-ccw-alt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            // 通常: enc_ccw_ctrl（スクロール or Ctrl+PgDn）
            // Alt 押しながら: Alt+Shift+Tab

            bindings = <&enc_ccw_ctrl>, <&kp LA(LS(TAB))>;

            mods = <(MOD_LALT | MOD_RALT)>;
            keep-mods = <(MOD_LALT | MOD_RALT)>;
        };

        // エンコーダ本体に割り当てる behavior-sensor-rotate

        enc_scroll_pg_mod: encoder-scroll-pg-mod {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;

            // CCW（左回し）→ enc_ccw_alt,  CW（右回し）→ enc_cw_alt

            bindings = <&enc_ccw_alt>, <&enc_cw_alt>;

            tap-ms = <20>;
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog MOUSE &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl MOUSE>;

            label = "MKP_EXIT_AML";
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        toADJUST_LAYER {
            bindings = <&mo 4>;
            key-positions = <70 73>;
        };

        toMOUSE_LAYER {
            bindings = <&mo 1>;
            key-positions = <73 74>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&enc_scroll_pg_mod>;
            bindings = <
&kp ESC    &kp N1      &kp N2  &kp N3    &kp N4        &kp N5                                  &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                      &kp NUMBER_6  &kp N7  &kp N8     &kp N9   &kp N0    &kp MINUS
&kp TAB    &kp Q       &kp W   &kp E     &kp R         &kp T                                   &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                    &kp Y         &kp U   &kp I      &kp O    &kp P     &mo_for_jp__JP_AT_JP_BACKQUOTE
&kp CAPS   &kp A       &kp S   &kp D     &kp F         &kp G               &kp INT_MUHENKAN    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp INT_HENKAN  &kp H         &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z       &kp X   &kp C     &kp V         &kp B               &kp PRINTSCREEN     &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp INSERT      &kp N         &kp M   &kp COMMA  &kp DOT  &kp FSLH  &mo_for_jp__JP_YEN_JP_UNDERSCORE
&kp LCTRL  &kp C_MUTE          &kp LWIN  &kp LEFT_ALT  &SandS LSHFT SPACE  &mo SCROLL                                                                  &lt 3 RET       &kp BSPC                                            &kp RCTRL
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&enc_scroll_pg_mod>;
            bindings = <
&to_layer_0 ESC     &to_layer_0 N1  &to_layer_0 N2  &to_layer_0 N3  &to_layer_0 N4  &to_layer_0 N5                     &trans  &trans  &trans  &trans                     &to_layer_0 N6  &to_layer_0 N7  &to_layer_0 N8  &to_layer_0 N9      &to_layer_0 N0            &to_layer_0 MINUS
&to_layer_0 TAB     &to_layer_0 Q   &to_layer_0 W   &to_layer_0 E   &to_layer_0 R   &to_layer_0 T                      &trans  &trans  &trans  &trans                     &to_layer_0 Y   &to_layer_0 U   &to_layer_0 I   &to_layer_0 O       &to_layer_0 P             &to_layer_0 EQUAL
&to_layer_0 CAPS    &to_layer_0 A   &mkp RCLK       &mkp MCLK       &mkp LCLK       &msc SCRL_UP    &msc SCRL_LEFT     &trans  &trans  &trans  &trans    &msc SCRL_LEFT   &msc SCRL_UP    &mkp LCLK       &mkp MCLK       &mkp RCLK           &to_layer_0 SINGLE_QUOTE  &to_layer_0 SEMICOLON
&to_layer_0 LSHIFT  &to_layer_0 Z   &to_layer_0 X   &mkp MB4        &mkp MB5        &msc SCRL_DOWN  &kp PRINTSCREEN    &trans  &trans  &trans  &trans    &kp PRINTSCREEN  &msc SCRL_DOWN  &mkp MB4        &mkp MB5        &to_layer_0 PERIOD  &to_layer_0 SLASH         &lt SCROLL BACKSLASH
&trans              &trans                          &trans          &trans          &trans          &trans                                               &trans           &trans                                                                                        &trans
            >;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &kp F1     &kp F2    &kp F3    &kp F4     &kp F5                 &trans  &trans  &trans  &trans              &kp LA(F2)    &kp KP_N7   &kp KP_N8  &kp KP_N9     &kp KP_SLASH     &kp KP_NUMLOCK
&trans  &kp F6     &kp F7    &kp F8    &kp F9     &kp F10                &trans  &trans  &trans  &trans              &kp LA(F1)    &kp KP_N4   &kp KP_N5  &kp KP_N6     &kp KP_MULTIPLY  &none
&trans  &kp F11    &kp F12   &kp UP    &none      &kp HOME  &kp PG_UP    &trans  &trans  &trans  &trans    &kp LPAR  &kp C_VOL_UP  &kp KP_N1   &kp KP_N2  &kp KP_N3     &kp KP_MINUS     &none
&trans  &none      &kp LEFT  &kp DOWN  &kp RIGHT  &kp END   &kp PG_DN    &trans  &trans  &trans  &trans    &kp RPAR  &kp C_VOL_DN  &kp KP_DOT  &kp KP_N0  &kp KP_EQUAL  &kp KP_PLUS      &none
&trans  &kp RSHFT            &trans    &trans     &trans    &trans                                         &trans    &kp DEL                                                             &studio_unlock
            >;
        };

        raise_layer {
            display-name = "Raise";
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
            bindings = <
&trans  &none  &none  &none      &none      &none                              &trans  &trans  &trans  &trans               &none     &none     &none     &none      &kp EQUAL  &mo_for_jp__JP_YEN_JP_PIPE
&trans  &none  &none  &none      &none      &none                              &trans  &trans  &trans  &trans               &none     &none     &none     &none      &none      &mo_for_jp__JP_LBRACKET_JP_LBRACE
&trans  &none  &none  &mkp RCLK  &mkp LCLK  &msc SCRL_UP    &msc SCRL_LEFT     &trans  &trans  &trans  &trans    &kp PG_UP  &kp HOME  &none     &kp UP    &none      &none      &mo_for_jp__JP_RBRACKET_JP_RBRACE
&trans  &none  &none  &mkp MB4   &mkp MB5   &msc SCRL_DOWN  &msc SCRL_RIGHT    &trans  &trans  &trans  &trans    &kp PG_DN  &kp END   &kp LEFT  &kp DOWN  &kp RIGHT  &none      &none
&trans  &none         &trans     &trans     &trans          &trans                                               &trans     &kp DEL                                             &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &none
&trans  &kp C_MUTE                  &trans        &trans        &trans        &trans                                      &trans    &kp DEL                                     &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
